# Copy to deploy/.env and chmod 600. Never commit deploy/.env.

# Public name Caddy will certificate. DuckDNS (stable) or sslip.io (no account).
# Examples: somnium.duckdns.org    or    140-238-10-20.sslip.io
SOMNIUM_HOSTNAME=somnium.duckdns.org
SOMNIUM_ACME_EMAIL=you@example.com

# Required. openssl rand -hex 32. The camera sends this as X-Somnium-Token.
SOMNIUM_PROCESS_TOKEN=

# xAI key. XAI_API_KEY is accepted as an alias by the server.
XAI_KEY=

# Optional gallery upload from the server. Leave both empty if the camera
# uploads the shot itself (it sends skip_gallery=1).
SOMNIUM_UPLOAD_URL=
SOMNIUM_UPLOAD_TOKEN=

# Optional. Used when a cook does not include lat/lon.
SOMNIUM_VENUE_LAT=
SOMNIUM_VENUE_LON=
SOMNIUM_VENUE_LABEL=

# Optional. Only for deploy/duckdns-update.sh.
DUCKDNS_DOMAIN=
DUCKDNS_TOKEN=
