# xAI (Grok) — used for prompt synthesis + image edits
XAI_KEY=xai-your-key-here

# Leave unset on the laptop: POST /v1/process stays open and the bridges
# send no token. Set both to point a laptop bridge at the Oracle VM.
# The camera's copy of the token lives in include/server_config.h, not here.
# SOMNIUM_PROCESS_TOKEN=
# SOMNIUM_SERVER_URL=https://somnium.duckdns.org/v1/process
# Bridge HTTP timeout in seconds. Default 240. Must stay under the board's
# 300s wait so the bridge can still return ERR. Caddy on the VM uses 360s,
# which is longer than the board, so the proxy is not what ends the cook.
# Values at or above 300 are capped to 290.
# SOMNIUM_PROCESS_TIMEOUT=240

# Optional gallery upload. Same names on the laptop and on the Oracle VM.
# Leave unset when the camera uploads the shot itself (it sends skip_gallery=1).
# SOMNIUM_UPLOAD_URL=https://www.somnium.photo/api/upload
# SOMNIUM_UPLOAD_TOKEN=

# Optional overrides for server/settings.json
# SOMNIUM_VENUE_LAT=47.6553
# SOMNIUM_VENUE_LON=-122.3035
# SOMNIUM_VENUE_LABEL=Seattle
# SOMNIUM_OUTPUT_DIR=outputs
