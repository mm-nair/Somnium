# xAI (Grok) — used for prompt synthesis + image edits
XAI_KEY=xai-your-key-here

# Leave unset for the laptop server: POST /v1/process stays open and the
# bridges send no token. Set both to point the laptop bridges at Fly.
# The camera's copy of the token lives in include/server_config.h, not here.
# SOMNIUM_PROCESS_TOKEN=
# SOMNIUM_SERVER_URL=https://your-app.fly.dev/v1/process

# Optional gallery upload from the laptop server. Leave unset when the
# camera uploads the shot itself (it sends skip_gallery=1).
# SOMNIUM_UPLOAD_URL=https://www.somnium.photo/api/upload
# SOMNIUM_UPLOAD_TOKEN=
